# libfuse v2 uses a multithreaded session loop. Its shutdown state is
# accessed by worker threads without synchronization, which Helgrind reports
# although the code is outside gfarm2fs.
{
   libfuse-session-races
   Helgrind:Race
   obj:*/libfuse.so.2*
}

# libfuse v3 reports races in its multithreaded session shutdown path.
# These accesses are outside gfarm2fs.
{
   libfuse3-session-races
   Helgrind:Race
   obj:*/libfuse3.so.3*
   obj:*/libfuse3.so.3*
   obj:*/libfuse3.so.3*
   obj:*/libfuse3.so.3*
   fun:mythread_wrapper
   fun:start_thread
   fun:clone
}

# libfuse v3 destroys a session mutex after its worker threads have exited.
# This is outside gfarm2fs.
{
   libfuse3-session-mutex-destroy
   Helgrind:Misc
   fun:mutex_destroy_WRK
   fun:fuse_session_destroy
   fun:fuse_destroy
   fun:fuse_main_real_versioned
   fun:fuse_main_fn
   fun:gfarm2fs_fuse_main
   fun:main
}

{
   libfuse3-session-exit-race
   Helgrind:Race
   fun:fuse_session_exit
   obj:*/libfuse3.so.3*
   obj:*/libfuse3.so.3*
   fun:mythread_wrapper
   fun:start_thread
   fun:clone
}

{
   libfuse3-session-exited-worker-race
   Helgrind:Race
   fun:fuse_session_exited
   obj:*/libfuse3.so.3*
   obj:*/libfuse3.so.3*
   fun:mythread_wrapper
   fun:start_thread
   fun:clone
}

{
   libfuse3-session-exited-main-race
   Helgrind:Race
   fun:fuse_session_exited
   fun:fuse_session_loop_mt
   fun:fuse_loop_mt
   fun:fuse_main_real_versioned
   fun:fuse_main_fn
   fun:gfarm2fs_fuse_main
   fun:main
}

# libfuse may leave a worker-thread allocation reachable only from its
# shutdown path. This is outside gfarm2fs.
{
   libfuse-thread-exit-definitely-lost
   Memcheck:Leak
   match-leak-kinds: definite
   fun:malloc
   obj:*libfuse.so*
   ...
   fun:start_thread
   fun:thread_start
}

# libp11-kit destroys a mutex during dynamic-library finalisation after the
# owning state has already become invalid. This is outside gfarm2fs.
{
   libp11-kit-mutex-destroy-at-exit
   Helgrind:Misc
   fun:mutex_destroy_WRK
   obj:*libp11-kit.so*
}

